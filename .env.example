# MultiClinicaBot Environment Configuration

# === MongoDB Configuration ===
MONGODB_URL=mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/

# === AI Configuration ===
OPENAI_API_KEY=your_openai_api_key_here
PROVIDER_TYPE=zismed

# === ZisMed SQL Server Configuration ===
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=your_server;Database=zismed;UID=your_user;PWD=your_password
# Alternative format: Server=server,port;Database=db;UID=user;PWD=pass;Encrypt=yes;TrustServerCertificate=yes

# === Redis Configuration ===
REDIS_URL=redis://localhost:6379

# === Legacy PostgreSQL (Optional - can be removed) ===
DATABASE_PG_URL=postgresql+asyncpg://user:pass@localhost:5432/multiclinica

# === HCWeb Configuration (if using) ===
API_BASE_HCWEB=http://your-hcweb-soap-endpoint/service.asmx

# === Application Settings ===
DEBUG=true
LOG_LEVEL=INFO