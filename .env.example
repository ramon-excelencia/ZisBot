# API Keys de Groq (sistema de rotación automática)
# La primera key es la principal, las adicionales son para rotación
GROQ_API_KEY=tu_primary_key_aqui
GROQ_API_KEY_2=tu_segunda_key_aqui  # Opcional
GROQ_API_KEY_3=tu_tercera_key_aqui  # Opcional
# Puedes agregar más keys: GROQ_API_KEY_4, GROQ_API_KEY_5, etc.

# Configuración Base de Datos SQL Server
DATABASE_URL=mssql+pyodbc://sa:password@host:port/database?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no

# Configuración MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=zismed_chatbot
